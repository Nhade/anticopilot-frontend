# Production build defaults (Cloudflare Pages). Committed on purpose — these are
# public values that get baked into the client bundle anyway. Dashboard env vars
# (process.env on Pages CI) take precedence over this file, so a correctly set
# NEXT_PUBLIC_API_URL in the Pages project overrides it with the same value.
# The token is NOT here — set NEXT_PUBLIC_API_TOKEN in the Pages dashboard.
NEXT_PUBLIC_API_URL=https://api.anticopilot.nhade.com
NEXT_PUBLIC_ANTICOPILOT_USER_ID=default-user

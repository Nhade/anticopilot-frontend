# AntiCopilot frontend environment variables.
# Copy to `.env.local` and fill in values as needed.

# Base URL for the AntiCopilot backend REST API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional bearer token for the AntiCopilot backend API (must match the backend's
# BACKEND_API_TOKEN). Leave blank if the backend runs without auth.
NEXT_PUBLIC_API_TOKEN=

# Development user ID sent to AntiCopilot REST endpoints until auth is available.
NEXT_PUBLIC_ANTICOPILOT_USER_ID=default-user
